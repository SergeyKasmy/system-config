[Settings]
# manual
gtk-application-prefer-dark-theme={{ eq .theme.gtk.color_scheme "prefer-dark" }}
gtk-font-name=Sans, 10
gtk-icon-theme-name={{ .theme.icons }}
gtk-theme-name={{ .theme.gtk.name }}
gtk-cursor-theme-name={{ .theme.cursor.name }}
gtk-cursor-theme-size={{ .theme.cursor.size }}

# automatically written settings transfered verbatim
gtk-sound-theme-name=ocean
gtk-primary-button-warps-slider=true
gtk-enable-animations=true
gtk-decoration-layout=icon:minimize,maximize,close
gtk-cursor-blink=true
gtk-cursor-blink-time=1000
