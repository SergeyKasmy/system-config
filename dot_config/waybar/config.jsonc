[
  {
    "output": ["DP-1", "DP-3", "HDMI-A-2"], /* DP-3 - main monitor via the iGPU; HDMI-A-2 - the TV */
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "modules-left": ["hyprland/workspaces", "hyprland/submap"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["pulseaudio", "upower#mouse", "cpu", "memory", "custom/free_space", "hyprland/language", "battery", "tray", "clock"],
    "sway/workspaces": {
      "all-outputs": true,
    },
    "hyprland/workspaces": {
      "all-outputs": true,
    },
    "hyprland/window": {
      "icon": true,
      "icon-size": 16,
    },
      "clock": {
          "format": "{:%A, %b %d, %H:%M}",
          "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "on-click": "gsimplecal",
      },
      "cpu": {
          "format": "{usage}% ",
      },
      "memory": {
          "format": "{}% "
      },
      "temperature": {
          "format": "{temperatureC}°C {icon}",
          "format-icons": ["", "", ""],
          "critical-threshold": 80,
      },
      "backlight": {
          // "device": "acpi_video1",
          "format": "{percent}% {icon}",
          "format-icons": ["", ""]
      },
      "battery": {
          "states": {
              // "good": 95,
              "warning": 30,
              "critical": 15
          },
          "format": "{capacity}% {icon}",
          "format-charging": "{capacity}% ",
          "format-plugged": "{capacity}% ",
          "format-alt": "{time} {icon}",
          // "format-good": "", // An empty format will hide the module
          // "format-full": "",
          "format-icons": ["", "", "", "", ""]
      },
    "tray": {
      "spacing": 4,
    },
      //"network": {
      //    "format-wifi": "{essid} ({signalStrength}%) ",
      //    "format-ethernet": "{ifname}: {ipaddr}/{cidr} ",
      //    "format-linked": "{ifname} (No IP) ",
      //    "format-disconnected": "Disconnected ⚠",
      //    "format-alt": "{ifname}: {ipaddr}/{cidr}"
      //},
      "pulseaudio": {
          "format": "{volume}% {icon}",
          "format-bluetooth": "{volume}% {icon}",
          "format-bluetooth-muted": " {icon}",
          "format-muted": "",
          "format-icons": {
              "headphone": "",
              "hands-free": "",
              "headset": "",
              "phone": "",
              "portable": "",
              "default": ["", "", ""]
          },
          "on-click": "hyprctl eval 'ExecApp(\"pavucontrol-qt\", { float = true })'"
      },
    "upower#mouse": {
      "native-path": "hidpp_battery_0",
      "format": "{percentage} 󰍽",
      "show-icon": false
    },
    "custom/free_space": {
      "exec": "free-space min --ignore '/boot,/.root,/.snapshots,'$HOME'/.snapshots,/mnt/hdd/.root,/mnt/hdd/.snapshots'",
      "interval": 30,
    }
  }
]
