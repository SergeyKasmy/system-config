#!/bin/sh
# Customize the theme for GTK apps and apps with quirks.
# hash: {{ printf "%s %s %s" .theme.gtk.name (output "sh" "-c" (printf "ls -d %s/.mozilla/firefox/*default* 2>/dev/null" .chezmoi.homeDir) | trim) (output "git" "-C" (joinPath .chezmoi.sourceDir "vendor/WhiteSur-gtk-theme") "rev-parse" "HEAD") | trim }}

set -e

gtk_theme={{ .theme.gtk.name }}
color_scheme={{ .theme.gtk.color_scheme }}
icon_theme={{ .theme.icons }}
theme={{ .theme.cursor.name }}
size={{ .theme.cursor.size }}

# Exported to the flatpaks that often host X11 clients: Steam, Steam games, and Lutris games.
# NOTE: Steam honours XCURSOR_SIZE but not XCURSOR_THEME (ValveSoftware/steam-for-linux#13209).
xwayland_size={{ .theme.cursor.xwayland_size }}
xwayland_flatpaks="com.valvesoftware.Steam net.lutris.Lutris"

## GTK Theme
# With GTK_USE_PORTAL=1 (see dot_config/uwsm/env) the theme comes from the desktop portal's Settings interface,
# which (via xdg-desktop-portal-gtk) reads them out of `gsettings`.
# This means gtk-{3,4}.0/settings.ini are ignored (the files themselves are still left for fallback, in case some apps still try to parse them).
# dconf is a binary blob and can't be tracked by chezmoi directly, hence this script.
#
# GTK property priority:
# gsettings (if `GTK_USE_PORTAL=1` is set), xsettings (X-era daemon), gtk-{3,4}.0/settings.ini, XCURSOR_THEME

# gsettings writes via the session bus.
# Without one (e.g. ssh) the write would go nowhere useful, so just skip.
# Unfortunately in this case the script would have to be run again :(
if ! command -v gsettings >/dev/null; then
    : # not installed, skip GTK theme
elif [ -n "$DBUS_SESSION_BUS_ADDRESS" ]; then
    gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme"
    gsettings set org.gnome.desktop.interface color-scheme "$color_scheme"
    gsettings set org.gnome.desktop.interface icon-theme "$icon_theme"
    gsettings set org.gnome.desktop.interface cursor-theme "$theme"
    gsettings set org.gnome.desktop.interface cursor-size "$size"
else
    echo "theming: no session bus, skipping gsettings" >&2
fi

## Qt Theme
# Config of KDE apps can't be tracked by chezmoi directly.
# They contain too much runtime/instance-specific state, and owning the file would mean a lot of pointless infighting.
# kwriteconfig6 merges just this one key instead.

if command -v kwriteconfig6 >/dev/null; then
    # ColorScheme=* means "follow the system/global color scheme" instead of a scheme name pinned to this file.
    # ...why is this not the default?
    kwriteconfig6 --file dolphinrc --group UiSettings --key ColorScheme '*'

    # NOTE: KF6's kded reads kded5rc, NOT kded6rc.
    # Disable the gtkconfig module. It regenerates gtk-{3,4}.0/settings.ini, .gtkrc-2.0 and xsettingsd.conf on every login,
    # thus overwriting our settings (why...) and spawns `xsettingsd` (double why).
    # Let me manage the theme files myself, KDE!
    kwriteconfig6 --file kded5rc --group "Module-gtkconfig" --key autoload false
fi

## X11 "quirky" apps
if command -v flatpak >/dev/null; then
    for app in $xwayland_flatpaks; do
        flatpak override --user --env=XCURSOR_SIZE="$xwayland_size" "$app"
    done
fi

## Firefox theme symlinks
# Symlink each Firefox default profile's chrome/ and user.js to the chezmoi-managed
# ~/.mozilla/firefox/firefox-themes (see private_dot_mozilla/private_firefox/exact_firefox-themes
# and vendor/rebuild-whitesur-theme.sh). Profile directories have a random suffix chezmoi can't
# target directly, so this last hop stays two plain symlinks instead of managed dotfiles.
firefox_theme_dir="$HOME/.mozilla/firefox/firefox-themes"

for profile_dir in "$HOME/.mozilla/firefox/"*default*; do
    [ -d "$profile_dir" ] || continue

    [ -L "$profile_dir/chrome" ] || rm -rf "$profile_dir/chrome"
    ln -sf "$firefox_theme_dir" "$profile_dir/chrome"

    [ -L "$profile_dir/user.js" ] || rm -f "$profile_dir/user.js"
    ln -sf "$firefox_theme_dir/user.js" "$profile_dir/user.js"
done

## Connect WhiteSur theme to Flatpak
# Builds and installs org.gtk.Gtk3theme.WhiteSur-<color> as a local flatpak runtime extension
# (see vendor/WhiteSur-gtk-theme/libs/lib-flatpak.sh:pakitheme_gtk3), so sandboxed GTK3 apps
# actually have the theme's gtk.css/gtk-dark.css/gtk.gresource available, not just the theme
# *name* (which flatpak apps already get from the desktop portal via gsettings above).
# GTK4/libadwaita apps ignore this entirely -- they only follow the portal's light/dark preference.
# Looks the theme up by name in ~/.themes, so must run after dot_themes/exact_WhiteSur-Dark is placed.
if command -v flatpak >/dev/null; then
    # No --silent-mode: it unconditionally requires root (lib-core.sh:full_sudo), which is only
    # actually needed for other tweaks.sh options like -g/--gdm. -F/--flatpak itself falls back to
    # `flatpak install --user` without root (lib-flatpak.sh:pakitheme_gtk3), which is what we want.
    "{{ joinPath .chezmoi.sourceDir "vendor/WhiteSur-gtk-theme/tweaks.sh" }}" --flatpak --color {{ trimPrefix "WhiteSur-" .theme.gtk.name | quote }}
else
    echo "theming: flatpak not installed, skipping WhiteSur flatpak theme connect" >&2
fi
